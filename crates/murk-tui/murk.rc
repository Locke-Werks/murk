#include <winver.h>

// First icon in the file: Explorer uses it, and Qt picks IDI_ICON1 for windows.
IDI_ICON1 ICON "@ICON@"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     @COMMA@
PRODUCTVERSION  @COMMA@
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Locke Werks"
            VALUE "FileDescription",  "@DESC@"
            VALUE "FileVersion",      "@VER@"
            VALUE "InternalName",     "@NAME@"
            VALUE "OriginalFilename", "@FILE@"
            VALUE "ProductName",      "Murk"
            VALUE "ProductVersion",   "@VER@"
            VALUE "LegalCopyright",   "Copyright Locke Werks. GPL-3.0-or-later."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
